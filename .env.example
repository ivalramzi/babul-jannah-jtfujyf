# ===== Redis (wajib). Buat database gratis di https://upstash.com atau Vercel > Storage > Upstash Redis =====
# (nama KV_REST_API_URL / KV_REST_API_TOKEN dari Vercel KV juga otomatis dikenali)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Admin =====
# Hash SHA-256 password admin:  npm run hash -- PASSWORD_BARU
# Bila kosong, password default "babuljannah" dipakai. WAJIB diganti sebelum dipublikasikan.
ADMIN_PASSWORD_HASH=
# Opsional: rahasia penanda tangan sesi admin (string acak panjang)
SESSION_SECRET=

# ===== Notifikasi push =====
# Buat sepasang kunci:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:halo@babuljannah.id

# ===== Pengingat terjadwal =====
# String acak. Vercel Cron otomatis mengirimnya sebagai Bearer; layanan cron luar memakai /api/cron?key=...
CRON_SECRET=
